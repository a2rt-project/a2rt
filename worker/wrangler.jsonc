{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a2rt-docs-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "AI_QA_ENABLED": "true",
    "AI_QA_BASE_URL": "https://api.deepseek.com",
    "AI_QA_MODEL": "deepseek-flash",
    "AI_QA_DOCS_URL_PREFIX": "https://www.a2rt.org/docs",
    "ALLOWED_ORIGIN": "https://www.a2rt.org"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
