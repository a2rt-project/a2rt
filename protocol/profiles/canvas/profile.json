{
  "id": "canvas.excalidraw",
  "version": "0.1",
  "a2rt_version": "0.2",
  "status": "mock_implemented",
  "editor_version": "0.18.1",
  "execution_policies": {
    "single_task_streaming": {
      "feedback_mode": "windowed",
      "max_inflight_events": 8,
      "max_active_operations": 1,
      "operation_scope": "actor"
    }
  },
  "event_types": [
    {
      "type": "canvas.pointer",
      "phases": [
        "begin",
        "update",
        "end",
        "cancel",
        "single"
      ],
      "payload_schema": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "pointerdown",
              "pointermove",
              "pointerup",
              "pointercancel"
            ]
          },
          "pointer_id": {
            "const": 1
          },
          "pointer_type": {
            "const": "mouse"
          },
          "space": {
            "const": "scene"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "button": {
            "enum": [
              -1,
              0
            ]
          },
          "buttons": {
            "enum": [
              0,
              1
            ]
          }
        },
        "required": [
          "name",
          "pointer_id",
          "pointer_type",
          "space",
          "x",
          "y",
          "button",
          "buttons"
        ],
        "additionalProperties": false
      },
      "supports_audio_timing": false
    }
  ],
  "tools": [
    {
      "server_id": "naoix-editor",
      "name": "editor_set_tool",
      "description": "Set the actor-local pointer tool; does not change the other actor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "selection",
              "ellipse",
              "freedraw",
              "eraser"
            ]
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "binding": {
        "categories": [
          "drawing_defaults"
        ],
        "target_binding": "none",
        "selection_policy": "none",
        "effect": "context",
        "presentation": "atomic",
        "scope": "current_board",
        "schema_source": "naoix_extension"
      },
      "supports_audio_timing": false
    },
    {
      "server_id": "naoix-editor",
      "name": "editor_set_style",
      "description": "Set explicit drawing defaults, selected-element style, or both. Fields use Excalidraw names.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "defaults",
              "selection",
              "defaults_and_selection"
            ]
          },
          "style": {
            "type": "object",
            "properties": {
              "strokeColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "backgroundColor": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{6}|transparent)$"
              },
              "strokeWidth": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "strokeStyle": {
                "enum": [
                  "solid",
                  "dashed",
                  "dotted"
                ]
              },
              "fillStyle": {
                "enum": [
                  "hachure",
                  "cross-hatch",
                  "solid",
                  "zigzag"
                ]
              },
              "roughness": {
                "type": "number",
                "minimum": 0
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [],
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "required": [
          "scope",
          "style"
        ],
        "additionalProperties": false
      },
      "binding": {
        "categories": [
          "drawing_defaults",
          "element"
        ],
        "target_binding": "by_scope",
        "selection_policy": "by_scope",
        "effect": "context_or_scene",
        "presentation": "atomic",
        "scope": "current_board",
        "schema_source": "naoix_extension"
      },
      "supports_audio_timing": false
    },
    {
      "server_id": "naoix-editor",
      "name": "editor_action",
      "description": "Align or group the actor selection. Bound to native editor Actions in a production adapter; computed by restricted geometry in this mock.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "alignTop",
              "group"
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "binding": {
        "categories": [
          "selection",
          "element"
        ],
        "target_binding": "current_selection",
        "selection_policy": "native_action",
        "effect": "scene",
        "presentation": "atomic",
        "scope": "current_board",
        "schema_source": "naoix_extension"
      },
      "supports_audio_timing": false
    }
  ],
  "state_schemas": {
    "canvas.state": {
      "type": "object",
      "required": [
        "executor_id",
        "snapshot_seq",
        "board_revision",
        "participants",
        "objects",
        "groups",
        "view",
        "operations"
      ],
      "properties": {
        "executor_id": {
          "type": "string"
        },
        "board_revision": {
          "type": "integer",
          "minimum": 0
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "actor",
              "tool",
              "style",
              "pointer",
              "selection",
              "active_operation_id",
              "interaction"
            ],
            "properties": {
              "actor": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "selection": {
                "title": "Participant selection snapshot",
                "type": "object",
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "status": {
                    "enum": [
                      "ready",
                      "updating"
                    ]
                  },
                  "element_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "group_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "editing_group_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "bounds": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "width": {
                            "type": "number",
                            "minimum": 0
                          },
                          "height": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "revision",
                  "status",
                  "element_ids",
                  "group_ids",
                  "editing_group_id",
                  "bounds"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "element_ids": {
                          "maxItems": 0
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "bounds": {
                          "type": "null"
                        },
                        "group_ids": {
                          "maxItems": 0
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "bounds": {
                          "type": "object"
                        }
                      }
                    }
                  }
                ],
                "description": "Full actor-local selection at this state version. Validate element/group references and revisions at runtime; an absent state update does not mean an empty selection."
              },
              "active_operation_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tool": {
                "enum": [
                  "selection",
                  "ellipse",
                  "freedraw",
                  "eraser"
                ]
              },
              "style": {
                "type": "object",
                "properties": {
                  "strokeColor": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "backgroundColor": {
                    "type": "string",
                    "pattern": "^(#[0-9a-fA-F]{6}|transparent)$"
                  },
                  "strokeWidth": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "strokeStyle": {
                    "enum": [
                      "solid",
                      "dashed",
                      "dotted"
                    ]
                  },
                  "fillStyle": {
                    "enum": [
                      "hachure",
                      "cross-hatch",
                      "solid",
                      "zigzag"
                    ]
                  },
                  "roughness": {
                    "type": "number",
                    "minimum": 0
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "strokeColor",
                  "backgroundColor",
                  "strokeWidth",
                  "strokeStyle",
                  "opacity"
                ],
                "additionalProperties": false
              },
              "pointer": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "buttons": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "captured": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "buttons",
                  "captured"
                ],
                "additionalProperties": false
              },
              "interaction": {
                "enum": [
                  "idle",
                  "tool_running",
                  "drawing",
                  "moving",
                  "selecting",
                  "erasing"
                ]
              }
            }
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "version",
              "isDeleted"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "rectangle",
                  "ellipse",
                  "freedraw"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "isDeleted": {
                "type": "boolean"
              }
            }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "element_ids": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "element_ids"
            ],
            "additionalProperties": false
          }
        },
        "view": {
          "type": "object",
          "required": [
            "zoom",
            "scroll_x",
            "scroll_y",
            "pixel_to_scene"
          ],
          "properties": {
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "scroll_x": {
              "type": "number"
            },
            "scroll_y": {
              "type": "number"
            },
            "pixel_to_scene": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "operation_id",
              "actor_id",
              "status",
              "revision"
            ],
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "actor_id": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "status": {
                "enum": [
                  "active",
                  "completed",
                  "failed",
                  "cancelled",
                  "unknown"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "snapshot_seq": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "binding": {
    "coordinates": "scene",
    "actors": [
      "assistant",
      "user"
    ],
    "user_execution": "local_then_observe",
    "assistant_selection_basis": "latest canvas.state at observed_feedback_seq",
    "visual_resource": "immutable native-renderer snapshot",
    "supported_pointer_tools": [
      "selection",
      "ellipse",
      "freedraw",
      "eraser"
    ],
    "conflict_policy": "no_object_locks; production Excalidraw reconciliation is outside this restricted mock"
  },
  "notes": [
    "Window 8 is a mock configuration, not a universal Canvas limit.",
    "Native controls are rendered by Excalidraw; geometry execution is a restricted mock.",
    "Independent audio and immediate events use a shared demo timeline, not sample-accurate model-generated speech alignment."
  ]
}
