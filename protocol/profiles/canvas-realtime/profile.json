{
  "profile_id": "canvas.excalidraw.realtime",
  "version": "0.3.0-draft",
  "core_design": "a2rt-clock-sync-group-track/2026-11-16",
  "binding_id": "canvas.a2rt.mock.v2",
  "roles": [
    "assistant",
    "user",
    "environment",
    "system"
  ],
  "tools": [
    {
      "server_id": "canvas-editor",
      "name": "editor_set_tool",
      "description": "Set the actor-local pointer tool; does not change the other actor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "selection",
              "ellipse",
              "freedraw",
              "eraser"
            ]
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "binding": {
        "categories": [
          "drawing_defaults"
        ],
        "target_binding": "none",
        "selection_policy": "none",
        "effect": "context",
        "presentation": "atomic",
        "scope": "current_board",
        "schema_source": "canvas_profile_mock"
      },
      "supports_audio_timing": true
    },
    {
      "server_id": "canvas-editor",
      "name": "editor_set_style",
      "description": "Set explicit drawing defaults, selected-element style, or both. Fields use Excalidraw names.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": [
              "defaults",
              "selection",
              "defaults_and_selection"
            ]
          },
          "style": {
            "type": "object",
            "properties": {
              "strokeColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "backgroundColor": {
                "type": "string",
                "pattern": "^(#[0-9a-fA-F]{6}|transparent)$"
              },
              "strokeWidth": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "strokeStyle": {
                "enum": [
                  "solid",
                  "dashed",
                  "dotted"
                ]
              },
              "fillStyle": {
                "enum": [
                  "hachure",
                  "cross-hatch",
                  "solid",
                  "zigzag"
                ]
              },
              "roughness": {
                "type": "number",
                "minimum": 0
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [],
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "required": [
          "scope",
          "style"
        ],
        "additionalProperties": false
      },
      "binding": {
        "categories": [
          "drawing_defaults",
          "element"
        ],
        "target_binding": "by_scope",
        "selection_policy": "by_scope",
        "effect": "context_or_scene",
        "presentation": "atomic",
        "scope": "current_board",
        "schema_source": "canvas_profile_mock"
      },
      "supports_audio_timing": true
    },
    {
      "server_id": "canvas-editor",
      "name": "editor_action",
      "description": "Align or group the actor selection. Bound to native editor Actions in a production adapter; computed by restricted geometry in this mock.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "alignTop",
              "group"
            ]
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      },
      "binding": {
        "categories": [
          "selection",
          "element"
        ],
        "target_binding": "current_selection",
        "selection_policy": "native_action",
        "effect": "scene",
        "presentation": "atomic",
        "scope": "current_board",
        "schema_source": "canvas_profile_mock"
      },
      "supports_audio_timing": true
    }
  ],
  "event_types": [
    {
      "type": "canvas.pointer",
      "phases": [
        "begin",
        "update",
        "end",
        "cancel",
        "single"
      ],
      "payload_schema": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "pointerdown",
              "pointermove",
              "pointerup",
              "pointercancel"
            ]
          },
          "pointer_id": {
            "const": 1
          },
          "pointer_type": {
            "const": "mouse"
          },
          "space": {
            "const": "scene"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "button": {
            "enum": [
              -1,
              0
            ]
          },
          "buttons": {
            "enum": [
              0,
              1
            ]
          }
        },
        "required": [
          "name",
          "pointer_id",
          "pointer_type",
          "space",
          "x",
          "y",
          "button",
          "buttons"
        ],
        "additionalProperties": false
      },
      "supports_audio_timing": true
    },
    {
      "type": "canvas.tool_call",
      "schema_ref": "./schemas/event.schema.json",
      "scope": "Canvas Profile only"
    },
    {
      "type": "canvas.noop",
      "schema_ref": "./schemas/event.schema.json",
      "scope": "Canvas Profile only"
    },
    {
      "type": "canvas.output_end",
      "schema_ref": "./schemas/event.schema.json",
      "scope": "Canvas Profile only"
    }
  ],
  "execution": {
    "max_active_tasks_per_actor": 1,
    "max_pending_actions_per_actor": 1,
    "decision_gate": "complete_observation",
    "control_bypass": [
      "canvas.output_end"
    ],
    "object_locking": false,
    "max_pending_user_facts": 64
  },
  "presentation": {
    "sample_rate": 24000,
    "channels": 1,
    "action_audio_window_ms": 100,
    "pre_roll_root_ticks": 100,
    "capture": "snapshot_after_action",
    "audio_coverage": "previous_complete_cutoff_to_current_cutoff",
    "visual_decoder": "excalidraw-scene-json",
    "post_recovery_min_slot_advance": 1,
    "audio_media_type": "audio/L16"
  },
  "recovery": {
    "retry_delay_root_ticks": 20,
    "max_attempts": 1,
    "operation_idle_root_ticks": 2000,
    "late_visual": "ignore_expired_observation",
    "reexecute_action": false,
    "owner": "runtime",
    "new_observation": "next_legal_interaction_slot",
    "assistant_request_required": false
  },
  "system_events": [
    "session.started",
    "observation.timeout",
    "observation.recovered",
    "session.suspended",
    "task.cleaned",
    "session.ended"
  ]
}
