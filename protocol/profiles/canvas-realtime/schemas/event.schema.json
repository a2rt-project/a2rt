{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "empty"
        },
        "event": {
          "type": "null"
        }
      },
      "required": [
        "mode",
        "event"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "control"
        },
        "event": {
          "type": "object",
          "properties": {
            "type": {
              "const": "canvas.output_end"
            },
            "output_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "output_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "mode",
        "event"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "data"
        },
        "event": {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "minLength": 1
            },
            "actor_id": {
              "enum": [
                "assistant",
                "user"
              ]
            },
            "context_id": {
              "const": "board_1"
            },
            "task_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "phase": {
              "enum": [
                "none",
                "begin",
                "update",
                "end",
                "cancel",
                "single"
              ]
            },
            "type": {
              "enum": [
                "canvas.noop",
                "canvas.pointer",
                "canvas.tool_call"
              ]
            },
            "payload": {
              "type": "object"
            },
            "timing": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "immediate"
                    }
                  },
                  "required": [
                    "mode"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "audio"
                    },
                    "track_id": {
                      "const": "assistant.audio"
                    },
                    "sample": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "late_policy": {
                      "const": "reject"
                    }
                  },
                  "required": [
                    "mode",
                    "track_id",
                    "sample",
                    "late_policy"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "time": {
              "type": "object",
              "properties": {
                "clock_id": {
                  "const": "root"
                },
                "tick": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "clock_id",
                "tick"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event_id",
            "actor_id",
            "context_id",
            "task_id",
            "phase",
            "type",
            "payload",
            "timing",
            "time"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "canvas.pointer"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "enum": [
                          "pointerdown",
                          "pointermove",
                          "pointerup",
                          "pointercancel"
                        ]
                      },
                      "pointer_id": {
                        "const": 1
                      },
                      "pointer_type": {
                        "const": "mouse"
                      },
                      "space": {
                        "const": "scene"
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "button": {
                        "enum": [
                          -1,
                          0
                        ]
                      },
                      "buttons": {
                        "enum": [
                          0,
                          1
                        ]
                      }
                    },
                    "required": [
                      "name",
                      "pointer_id",
                      "pointer_type",
                      "space",
                      "x",
                      "y",
                      "button",
                      "buttons"
                    ],
                    "additionalProperties": false
                  },
                  "task_id": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "canvas.noop"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  },
                  "task_id": {
                    "type": "null"
                  },
                  "phase": {
                    "const": "none"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "canvas.tool_call"
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "type": "object",
                    "properties": {
                      "server_id": {
                        "const": "canvas-editor"
                      },
                      "name": {
                        "enum": [
                          "editor_set_tool",
                          "editor_set_style",
                          "editor_action"
                        ]
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "server_id",
                      "name",
                      "arguments"
                    ],
                    "additionalProperties": false
                  },
                  "task_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase": {
                    "const": "begin"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "canvas.tool_call"
                  },
                  "payload": {
                    "properties": {
                      "name": {
                        "const": "editor_set_tool"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "properties": {
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "enum": [
                              "selection",
                              "ellipse",
                              "freedraw",
                              "eraser"
                            ]
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "canvas.tool_call"
                  },
                  "payload": {
                    "properties": {
                      "name": {
                        "const": "editor_set_style"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "properties": {
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "scope": {
                            "enum": [
                              "defaults",
                              "selection",
                              "defaults_and_selection"
                            ]
                          },
                          "style": {
                            "type": "object",
                            "properties": {
                              "strokeColor": {
                                "type": "string",
                                "pattern": "^#[0-9a-fA-F]{6}$"
                              },
                              "backgroundColor": {
                                "type": "string",
                                "pattern": "^(#[0-9a-fA-F]{6}|transparent)$"
                              },
                              "strokeWidth": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "strokeStyle": {
                                "enum": [
                                  "solid",
                                  "dashed",
                                  "dotted"
                                ]
                              },
                              "fillStyle": {
                                "enum": [
                                  "hachure",
                                  "cross-hatch",
                                  "solid",
                                  "zigzag"
                                ]
                              },
                              "roughness": {
                                "type": "number",
                                "minimum": 0
                              },
                              "opacity": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                              }
                            },
                            "required": [],
                            "additionalProperties": false,
                            "minProperties": 1
                          }
                        },
                        "required": [
                          "scope",
                          "style"
                        ],
                        "additionalProperties": false
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "canvas.tool_call"
                  },
                  "payload": {
                    "properties": {
                      "name": {
                        "const": "editor_action"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "payload": {
                    "properties": {
                      "arguments": {
                        "type": "object",
                        "properties": {
                          "action": {
                            "enum": [
                              "alignTop",
                              "group"
                            ]
                          }
                        },
                        "required": [
                          "action"
                        ],
                        "additionalProperties": false
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "basis_observation_id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "const": "observed"
        }
      },
      "required": [
        "mode",
        "event"
      ],
      "additionalProperties": false
    }
  ]
}
