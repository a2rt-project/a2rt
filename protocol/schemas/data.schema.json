{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2rt:0.2:data",
  "$defs": {
    "audio": {
      "type": "object",
      "properties": {
        "start_sample": {
          "type": "integer",
          "minimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "media"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "silence"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "requires_events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "start_sample",
        "sample_count",
        "content",
        "requires_events"
      ],
      "additionalProperties": false
    },
    "event_record": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "urn:a2rt:0.2:event"
        },
        "disposition": {
          "const": "observed"
        }
      },
      "required": [
        "event",
        "disposition"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "accepted",
            "running",
            "applied",
            "completed",
            "rejected",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "operation_status": {
          "enum": [
            "active",
            "completed",
            "failed",
            "cancelled",
            "unknown",
            null
          ]
        },
        "time": {
          "type": "object",
          "properties": {
            "clock_id": {
              "type": "string",
              "minLength": 1
            },
            "t_us": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "clock_id",
            "t_us"
          ],
          "additionalProperties": false
        },
        "result": {
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "event_id",
        "operation_id",
        "revision",
        "status",
        "operation_status",
        "time",
        "result",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "running",
                  "applied"
                ]
              },
              "operation_id": {
                "type": "string"
              }
            },
            "required": [
              "operation_id"
            ]
          },
          "then": {
            "properties": {
              "operation_status": {
                "const": "active"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "rejected"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "visual": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "source_state_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stream_id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "stream_id",
              "revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ref",
        "mime_type",
        "width",
        "height",
        "source_state_refs"
      ],
      "additionalProperties": false
    },
    "playback": {
      "type": "object",
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "played_sample": {
          "type": "integer",
          "minimum": 0
        },
        "buffered_until_sample": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "playing",
            "paused",
            "underrun",
            "stopped"
          ]
        }
      },
      "required": [
        "stream_id",
        "played_sample",
        "buffered_until_sample",
        "state"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "object"
        }
      },
      "required": [
        "schema_id",
        "revision",
        "value"
      ],
      "additionalProperties": false
    },
    "control_result": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "accepted",
            "completed",
            "failed",
            "unknown"
          ]
        },
        "result": {
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request_id",
        "revision",
        "status",
        "result",
        "error"
      ],
      "additionalProperties": false
    }
  }
}
