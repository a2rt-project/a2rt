{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2rt:0.2:manifest",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "a2rt/0.2"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "assistant_actor_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "assistant",
              "user",
              "agent",
              "system"
            ]
          }
        },
        "required": [
          "source_id",
          "actor_id",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "context_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "execution_policy_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "context_id",
          "profile_id",
          "execution_policy_id"
        ],
        "additionalProperties": false
      }
    },
    "clocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clock_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "clock_id",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "schema_ref",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stream_id": {
            "type": "string",
            "minLength": 1
          },
          "track": {
            "enum": [
              "assistant.audio",
              "assistant.events",
              "environment.audio",
              "environment.events",
              "environment.visual",
              "environment.state"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "clock_id": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "type": "object",
            "properties": {
              "encoding": {
                "type": "string",
                "minLength": 1
              },
              "sample_rate": {
                "type": "integer",
                "minimum": 1
              },
              "channels": {
                "type": "integer",
                "minimum": 1
              },
              "origin_t_us": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "encoding",
              "sample_rate",
              "channels",
              "origin_t_us"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "stream_id",
          "track",
          "source_id",
          "format",
          "clock_id"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "track": {
                  "enum": [
                    "assistant.audio",
                    "environment.audio"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "audio"
              ],
              "properties": {
                "format": {
                  "const": "core.audio"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "audio"
                ]
              }
            }
          }
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "feedback_deadline_ms": {
          "type": "integer",
          "minimum": 1
        },
        "operation_idle_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "media_dependency_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_queued_updates": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_deadline_ms": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "feedback_deadline_ms",
        "operation_idle_timeout_ms",
        "media_dependency_timeout_ms",
        "max_queued_updates",
        "recovery_max_attempts",
        "recovery_deadline_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "manifest_id",
    "session_id",
    "epoch",
    "assistant_actor_id",
    "sources",
    "contexts",
    "clocks",
    "profiles",
    "streams",
    "limits"
  ],
  "additionalProperties": false
}
