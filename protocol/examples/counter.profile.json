{
  "id": "example.counter",
  "version": "0.2",
  "note": "Documentation fixture only; not a deployed environment.",
  "event_types": [
    {
      "type": "example.counter.increment",
      "phases": [
        "single"
      ],
      "payload_schema": {
        "type": "object",
        "properties": {
          "by": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          }
        },
        "required": [
          "by"
        ],
        "additionalProperties": false
      },
      "supports_audio_timing": true
    },
    {
      "type": "example.counter.adjust",
      "phases": [
        "begin",
        "update",
        "end",
        "cancel"
      ],
      "payload_schema": {
        "type": "object",
        "properties": {
          "by": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          }
        },
        "required": [
          "by"
        ],
        "additionalProperties": false
      },
      "supports_audio_timing": true,
      "description": "Apply by at each ordered event of one continuous adjustment; cancel cleans up without undoing applied increments."
    }
  ],
  "tools": [
    {
      "server_id": "counter",
      "name": "set_value",
      "inputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "effect": "modify",
      "presentation": "atomic",
      "target_binding": "current_context"
    }
  ],
  "state_schemas": {
    "example.counter.state": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "count"
      ],
      "additionalProperties": false
    }
  },
  "execution_policies": {
    "streaming": {
      "feedback_mode": "windowed",
      "max_inflight_events": 8,
      "max_active_operations": 1,
      "operation_scope": "actor"
    },
    "stepwise": {
      "feedback_mode": "per_event",
      "max_inflight_events": 1,
      "max_active_operations": 1,
      "operation_scope": "actor"
    },
    "parallel": {
      "feedback_mode": "windowed",
      "max_inflight_events": 8,
      "max_active_operations": 2,
      "operation_scope": "actor"
    }
  }
}
